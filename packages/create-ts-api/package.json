{
  "name": "create-ts-api",
  "version": "2.0.1",
  "description": "Interactive CLI tool to instantly scaffold production-grade Node.js TypeScript APIs in seconds",
  "keywords": [
    "api",
    "create-ts-api",
    "express",
    "graphql",
    "scaffold",
    "typescript"
  ],
  "homepage": "https://github.com/bineetNaidu/create-ts-api#readme",
  "bugs": {
    "url": "https://github.com/bineetNaidu/create-ts-api/issues"
  },
  "license": "MIT",
  "author": "Bineet Naidu (https://x.com/nobineetnaidu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bineetNaidu/create-ts-api.git"
  },
  "bin": {
    "create-ts-api": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build && cp -R ../templates .",
    "postpack": "rm -rf templates"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "simple-git": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
