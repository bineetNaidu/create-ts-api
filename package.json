{
  "name": "create-ts-api",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive CLI tool to instantly bootstrap production-ready TypeScript Node.js APIs",
  "keywords": [
    "Node",
    "api",
    "express",
    "graphql",
    "typescript"
  ],
  "license": "MIT",
  "author": "Bineet Naidu (https://x.com/nobineetnaidu)",
  "workspaces": [
    "packages/*",
    "packages/templates/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "npm run fmt:check"
    ],
    "*.{js,ts,jsx,tsx}": [
      "npm run lint"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
